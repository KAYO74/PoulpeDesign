{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poulpe",
  "version": "1.1.1",
  "identifier": "org.poulpe.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @poulpe/editor dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @poulpe/editor build",
    "frontendDist": "../../editor/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Poulpe Design",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      },
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg", "app"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Création graphique libre",
    "longDescription": "Poulpe Design est une application libre de création graphique : dessin vectoriel, retouche photo et mise en page, avec vectorisation d'images, détourage automatique, macros et extensions.",
    "copyright": "Contributeurs de Poulpe Design, MPL-2.0",
    "license": "MPL-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["poulpe"],
        "name": "Document Poulpe Design",
        "description": "Document Poulpe Design",
        "mimeType": "application/x-poulpe",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "languages": ["French", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "./windows/langue.nsh"
      }
    },
    "linux": {
      "deb": { "section": "graphics" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwNUQ3Mjc3N0Q0NEYyMjcKUldRbjhrUjlkM0pkWUptV1pCQlFCL3pNNkFvbWxuaUoxZFp6Yjl4Z2IyRmxTMWgxaStTNmxndVkK",
      "endpoints": ["https://github.com/KAYO74/Poulpe/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
