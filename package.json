{
  "name": "poulpe",
  "private": true,
  "version": "1.2.2",
  "license": "MPL-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @poulpe/editor dev",
    "build": "pnpm --filter @poulpe/editor build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @poulpe/editor e2e",
    "desktop:dev": "pnpm --filter @poulpe/desktop tauri dev",
    "desktop:build": "pnpm --filter @poulpe/desktop tauri build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
